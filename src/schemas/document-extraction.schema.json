{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentExtractionResult",
  "type": "object",
  "required": ["document","classifiedAs","classificationConfidence","fields","warnings","humanReviewRequired"],
  "properties": {
    "document": {
      "type": "object",
      "required": ["documentId","fileName"],
      "properties": {
        "documentId": {"type":"string","minLength":1},
        "fileName": {"type":"string","minLength":1},
        "mimeType": {"type":"string"},
        "receivedAt": {"type":"string"},
        "periodStart": {"type":"string"},
        "periodEnd": {"type":"string"},
        "source": {"type":"string"}
      },
      "additionalProperties": false
    },
    "classifiedAs": {
      "type":"string",
      "enum":["BANK_STATEMENT","PROFIT_AND_LOSS","BALANCE_SHEET","TAX_RETURN","INVOICE","ACCOUNTS_RECEIVABLE_AGING","DEBT_SCHEDULE","OTHER"]
    },
    "classificationConfidence":{"type":"number","minimum":0,"maximum":1},
    "fields":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["field","value","confidence","reviewRequired"],
        "properties":{
          "field":{"type":"string"},
          "value":{},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "sourcePage":{"type":"integer","minimum":1},
          "sourceReference":{"type":"string"},
          "reviewRequired":{"type":"boolean"}
        },
        "additionalProperties": false
      }
    },
    "warnings":{"type":"array","items":{"type":"string"}},
    "humanReviewRequired":{"type":"boolean"},
    "provider":{"type":"string"}
  },
  "additionalProperties": false
}
